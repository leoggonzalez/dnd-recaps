  "events": [
    {
      "date": "6 Ches 1492 DR",
      "location": "Road from Baldur's Gate to Waterdeep",
      "event": "Sent Coppergoat to ram an attacking spider, then used force darts against the attackers while defending the caravan horses."
    },
    {
      "date": "7–9 Ches 1492 DR",
      "location": "Road from Baldur’s Gate to Waterdeep",
      "event": "Identified the recovered parchment as a Spell Scroll (Tremor) and transferred it from Balerias’s keeping to Lucien."
    },
    {
      "date": "7–9 Ches 1492 DR",
      "location": "Road from Baldur’s Gate to Waterdeep",
      "event": "Taught Zelina Innevar to draw sparks from the Weave and found the source of her magic elusive. She privately showed him her sketch for a nightglass perfume vial."
    },
    {
      "date": "7–9 Ches 1492 DR",
      "location": "Road from Baldur’s Gate to Waterdeep",
      "event": "Gave the buried Carlon Amoffel water and summoned Copperbear from the Bag of Tricks (Rust) to help dig him out."
    },
    {
      "date": "7–9 Ches 1492 DR",
      "location": "Road from Baldur’s Gate to Waterdeep",
      "event": "Rode Copperbear while discussing possible cult decoys with Aldrik, climbed into Losvius’s porcelain-filled wagon, and helped secure a wager for Losvius to investigate a cult wagon."
    },
    {
      "date": "7–9 Ches 1492 DR",
      "location": "Road from Baldur’s Gate to Waterdeep",
      "event": "Worked on Rumble’s Goggles of Night while the caravan waited out the downpour. Asked about nightglass and learned from Samardag that it meant obsidian in Amn."
    },
    {
      "date": "7–9 Ches 1492 DR",
      "location": "Road from Baldur’s Gate to Waterdeep",
      "event": "Lost twenty gold gambling with Radecere Perethun and bought his lucky pendant for another two hundred and fifty gold."
    },
    {
      "date": "7–9 Ches 1492 DR",
      "location": "Road from Baldur’s Gate to Waterdeep",
      "event": "Helped Zelina magically mend obsidian into a copper-bound perfume vial for Arietta and gave Zelina five gold for perfume."
    },
    {
      "date": "7–9 Ches 1492 DR",
      "location": "Road from Baldur’s Gate to Waterdeep",
      "event": "Identified the roadside shriekers and their shared mycelium with Aldrik and Lucien. Retreated when their cries brought overwhelming grief and later blamed Carlon, whom he called Sprout."
    },
    {
      "date": "7–9 Ches 1492 DR",
      "location": "Road from Baldur’s Gate to Waterdeep",
      "event": "Began planning an approach to the overturned wagon under hobgoblin attack with Aldrik and Lucien."
    }
  ],
