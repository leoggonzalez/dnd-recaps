    {
      "id": "an-offering-for-the-peryton",
      "title": "An offering for the peryton",
      "environmentId": "caravan-camp",
      "description": "Balerias changes to offering pose; peryton approaches behind cage bars; subtle glimmer appears.",
      "durationMs": 4800,
      "narration": [
        {
          "id": "segment-1",
          "text": "Balerias extended food through the cage while Oyn kept a safer distance.",
          "delayMs": 150,
          "durationMs": 450
        },
        {
          "id": "segment-2",
          "text": "The peryton accepted and stayed close. Something glimmered strangely in its eyes.",
