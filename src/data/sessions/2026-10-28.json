    {
      "id": "a-note-in-the-dark",
      "title": "A note in the dark",
      "environmentId": "sleeping-space",
      "description": "Sleeping-space layers; journal and pen cutouts; pen moves over the page.",
      "durationMs": 4800,
      "narration": [
        {
          "id": "segment-1",
          "text": "Invisible, Lucien searched the sisters’ belongings and found a healing potion and a journal.",
          "delayMs": 150,
          "durationMs": 450
        },
        {
          "id": "segment-2",
          "text": "Its entries concealed familiar names behind descriptions. On the final page, he disguised his handwriting:",
          "delayMs": 850,
          "durationMs": 450
        },
        {
          "id": "segment-3",
          "text": "“I know what you are doing.”",
          "delayMs": 1550,
          "durationMs": 450
        }
      ],
      "actors": [],
      "reducedMotion": "final",
      "artwork": "planned"
    },
    {
      "id": "counting-the-wagons",
      "title": "Counting the wagons",
      "environmentId": "woodland-road",
      "description": "Exactly three guarded wagons recede behind Aldrik and Balerias as they discuss the unconfirmed decoy suspicion away from prying ears.",
      "durationMs": 4800,
      "narration": [
        {
          "id": "segment-1",
          "text": "Aldrik rode past three cult wagons, studying their disciplined watches. The middle wagon carried an extra traveller.",
          "delayMs": 150,
          "durationMs": 450
        },
        {
          "id": "segment-2",
          "text": "Could one be a decoy? For now, it was only a suspicion.",
          "delayMs": 850,
          "durationMs": 450
        },
        {
          "id": "segment-3",
          "text": "Far from prying eyes, Aldrik and Balerias discussed the wagons.",
          "delayMs": 1550,
          "durationMs": 450
        },
        {
          "id": "segment-4",
          "text": "They agreed that earning the cultists’ trust might help them follow if the wagons left the caravan.",
          "delayMs": 2250,
          "durationMs": 450
        }
      ],
      "actors": [],
      "reducedMotion": "final",
      "artwork": "planned"
    },
    {
      "id": "under-the-horses-neck",
      "title": "Under the horse’s neck",
      "environmentId": "tangled-forest",
      "description": "Aldrik rides sideways and aims his light crossbow beneath his horse’s neck at a huge spider. Tangled forest and webs frame the attack; no additional kill is implied.",
      "durationMs": 4800,
      "narration": [
        {
          "id": "segment-1",
          "text": "The road narrowed beneath tangled branches. Webbing caught the horses; three ettercaps and huge spiders emerged.",
          "delayMs": 150,
          "durationMs": 450
        },
        {
          "id": "segment-2",
          "text": "The caravan fought back. From horseback, Aldrik sighted beneath his horse’s neck with his light crossbow.",
          "delayMs": 850,
          "durationMs": 450
        }
      ],
      "actors": [],
      "reducedMotion": "final",
      "artwork": "planned"
    },
    {
      "id": "the-horses-fight-back",
      "title": "The horses fight back",
      "environmentId": "tangled-forest",
      "description": "Strawberry Three and Mo Two strike back at the spiders. Nearby, an ettercap drags a webbed horse; Lucien stops it before the horse can be taken away.",
      "durationMs": 6000,
      "narration": [
        {
          "id": "segment-1",
          "text": "The intended prey fought back. Strawberry Three kicked; Mo Two struck another attacker.",
          "delayMs": 150,
          "durationMs": 450
        },
        {
          "id": "segment-2",
          "text": "Pounding hooves helped bring down a great spider.",
          "delayMs": 850,
          "durationMs": 450
        },
        {
          "id": "segment-3",
          "text": "An ettercap wrapped a horse in silk and began hauling it toward the forest.",
          "delayMs": 1550,
          "durationMs": 450
        },
        {
          "id": "segment-4",
          "text": "Lucien killed the creature before it could carry the horse away.",
          "delayMs": 2250,
          "durationMs": 450
        }
      ],
