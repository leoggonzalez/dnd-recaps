  "scenes": [
    {
      "id": "a-little-luck",
      "title": "A little luck",
      "environmentId": "caravan-camp-night",
      "description": "The caravan rests for the night. Twelve wagons stand parked in a long line behind five seated gamblers. Lucien and Arietta sit together; Balerias plays too. Sulesdeg and Tyjit keep watch.",
      "durationMs": 4800,
      "narration": [
        {
          "id": "segment-1",
          "text": "The long caravan had stopped for the night. Along the parked wagons, Samardag called a game of Three-Dragon Ante.",
          "delayMs": 150,
          "durationMs": 450
        },
        {
          "id": "segment-2",
          "text": "Lucien and Arietta sat together at the cards, with Balerias playing too. Radecere brought a surprisingly substantial purse.",
          "delayMs": 850,
          "durationMs": 450
        },
        {
          "id": "segment-3",
          "text": "Sulesdeg and Tyjit stood watch without joining.",
          "delayMs": 1550,
          "durationMs": 450
        }
      ],
      "actors": [
        {
          "id": "night-guards",
          "assetId": "camp-night-guards",
          "position": {
            "x": 300,
            "y": 790
          },
          "width": 550,
          "zIndex": 35,
          "poses": []
        },
        {
          "id": "night-gamblers",
          "assetId": "camp-night-gamblers",
          "position": {
            "x": 1110,
            "y": 1025
          },
          "width": 1280,
          "zIndex": 50,
          "poses": []
        }
      ],
      "reducedMotion": "final",
      "artwork": "prototype"
    },
    {
      "id": "a-walk-through-camp",
      "title": "A walk through camp",
      "environmentId": "caravan-camp",
      "description": "Two cutouts move together a short distance through the lantern-lit camp and settle.",
      "durationMs": 4800,
      "narration": [
        {
          "id": "segment-1",
          "text": "By lanternlight, Arietta asked about Lucien’s past and the magic in his bloodline.",
          "delayMs": 150,
          "durationMs": 450
        },
        {
          "id": "segment-2",
          "text": "Lucien sensed she was concealing something. He could not yet say what.",
          "delayMs": 850,
          "durationMs": 450
        }
      ],
      "actors": [
        {
          "id": "walking-pair",
