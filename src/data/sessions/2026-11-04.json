  "scenes": [
    {
      "id": "the-markings",
      "title": "The markings",
      "environmentId": "lucien-dream",
      "description": "Lucien stands in a shadowed hall before black water that leads to a bridge crowded with soldiers. A warm reflection hints at a traveller in the river.",
      "durationMs": 10500,
      "narrationAudio": "assets/audio/sessions/04.11.2026 · 7–9 Ches 1492 DR Scene 1 of 10.mp3",
      "narration": [
        {
          "id": "chamber",
          "text": "Lucien stood before a familiar robed figure in a chamber of polished black stone. News of someone seen near a town dissolved beneath the rush of water.",
          "delayMs": 0,
          "durationMs": 480
        },
        {
          "id": "crossing",
          "text": "Black liquid seeped through the tiles. The chamber became a bridge crowded with soldiers, with arrows overhead and a dark river below.",
          "delayMs": 3100,
          "durationMs": 480
        },
        {
          "id": "glimpse",
          "text": "In a patch of warm sunlight, Lucien caught the reflection of a traveller wearing a woollen cap.",
          "delayMs": 6900,
          "durationMs": 480
        }
      ],
      "artwork": "prototype",
      "actors": [
        {
          "id": "lucien-watching",
          "assetId": "lucien-dream-watching",
          "position": {
            "x": 170,
            "y": 1170
          },
          "width": 490,
          "zIndex": 45,
          "poses": []
        }
      ],
      "reducedMotion": "final"
    },
    {
      "id": "the-crossing-lost",
      "title": "The crossing lost",
      "environmentId": "dream-crossing-lost",
      "description": "A traveller’s marked forehead appears in the river, with broken swords and graves on the near bank and soldiers fading into the haze beyond the bridge.",
      "durationMs": 15000,
      "narration": [
        {
          "id": "river",
          "text": "The river held the traveller’s reflection in a patch of warm sunlight.",
          "delayMs": 0,
          "durationMs": 480
        },
        {
          "id": "reflection",
          "text": "A gust lifted the woollen cap and exposed intricate markings across his forehead. “The markings! Remember the markings!”",
          "delayMs": 1550,
          "durationMs": 480
        },
        {
          "id": "dagger",
          "text": "Broken swords and forgotten graves. Voices whispered of a crossing lost. One word came through, “Dagger,” before black water swallowed him.",
          "delayMs": 6900,
          "durationMs": 480
        },
        {
          "id": "awakening",
          "text": "Lucien woke tangled in blankets. Across the wagon, Arietta asked whether he always dreamed so intensely.",
          "delayMs": 12000,
          "durationMs": 480
        }
      ],
      "artwork": "prototype",
      "actors": [
        {
          "id": "marching-bridge",
          "assetId": "lucien-dream-march-a",
