    {
      "id": "the-man-in-the-road",
      "title": "The man in the road — Carlon Amoffel",
      "environmentId": "caravan-road",
      "description": "Carlon’s head protrudes from the road, a complex circular rune tattooed on his forehead. Coppercoil offers water while Lucien kneels nearby. Behind them, a thread of charm magic runs from Aldrik’s hand to Lord Aldor.",
      "durationMs": 15000,
      "narration": [
        {
          "id": "discovery",
          "text": "The caravan stopped at a man buried up to his neck. A complex circular rune marked his forehead as an oathbreaker. Coppercoil gave him water.",
          "delayMs": 0,
          "durationMs": 480
        },
        {
          "id": "objection",
          "text": "Tyjit demanded they dig him out. Lord Aldor Urnpoleshurst objected to the delay. Lucien thought the marking echoed his dream and volunteered to take responsibility for the man.",
          "delayMs": 2600,
          "durationMs": 480
        },
        {
          "id": "friends",
          "text": "Aldrik cast Friends to sway Aldor. When objections persisted, Sulesdeg rose to his full height and announced that the caravan had decided.",
          "delayMs": 5700,
          "durationMs": 480
        },
        {
          "id": "rescue",
          "text": "Coppercoil summoned Copperbear. The bear and the travellers dug Carlon Amoffel free, then caught him when his legs buckled.",
          "delayMs": 10300,
          "durationMs": 480
        }
      ],
      "artwork": "prototype",
