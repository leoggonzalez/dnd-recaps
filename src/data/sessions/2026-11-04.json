    {
      "id": "a-thread-of-light",
      "title": "A thread of light",
      "environmentId": "daylight-wagon",
      "description": "Inside Coppercoil’s daylit wagon workshop, warm sparks light Zelina’s open palm as Coppercoil leans in. His workbench and parts rack frame the lesson, with the nightglass vial sketch in front and Arietta by the opening.",
      "durationMs": 14000,
      "narration": [
        {
          "id": "lesson",
          "text": "Zelina asked Coppercoil for a lesson in magic. Her first attempt produced a thread of light and a small pop.",
          "delayMs": 0,
          "durationMs": 480
        },
        {
          "id": "weave",
          "text": "Under his guidance she found the pattern of the Weave. Sparks warmed her palm. “I did that,” she said.",
          "delayMs": 1650,
          "durationMs": 480
        },
        {
          "id": "origin",
          "text": "Coppercoil could not place the magic. Soon Zelina tired, describing it as something tugging at a thread inside her.",
          "delayMs": 5700,
          "durationMs": 480
        },
        {
          "id": "gift",
          "text": "While Arietta was occupied, Zelina showed him her sketch of a black-glass perfume vial bound with copper wire. Her mother had called the material nightglass, and she wanted to make Arietta a gift.",
          "delayMs": 9300,
          "durationMs": 480
        }
      ],
      "artwork": "prototype",
      "actors": [
        {
          "id": "thread-to-palm",
          "assetId": "zelina-lesson-thread",
